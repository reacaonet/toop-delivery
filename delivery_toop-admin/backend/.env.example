# Firebase Admin (Service Account) — o firebase.txt traz a Conta de serviço
# firebase-adminsdk-fbsvc@enduring-honor-419212.iam.gserviceaccount.com e o
# certificado VAPID do web push. FALTA o PRIVATE_KEY (baixe o JSON em
# Console Firebase -> Project settings -> Service accounts -> Generate new
# private key). Necessário para o envio de push pelo backend. Sem ele, o envio
# degrada ao montar a notificação e retorna "FCM não configurado".
FIREBASE_ADMIN_ENABLED=false
FIREBASE_ADMIN_PROJECT_ID=enduring-honor-419212
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@enduring-honor-419212.iam.gserviceaccount.com
