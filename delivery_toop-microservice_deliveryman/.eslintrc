{
  "env": {
    "browser": true,
    "es6": true
  },
  "extends": ["google", "plugin:@typescript-eslint/recommended"],
  "globals": {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly"
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "overrides": [
    {
      "files": [
        "src/**/*.ts"
      ],
      "rules": {
        "require-jsdoc": 0,
        "indent": ["error", 2]
      }
    }
  ],
}
