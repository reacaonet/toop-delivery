{
  "private": true,
  "name": "toop-delivery",
  "description": "Gestor de pedidos para restaurantes do Toop",
  "version": "0.3.2",
  "main": "app/background.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider nextron",
    "build": "build:64 && build:32",
    "build:64": "nextron build",
    "build:32": "nextron build --win --ia32"
  },
  "dependencies": {
    "@chakra-ui/react": "^1.6.4",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@hookform/resolvers": "^2.6.0",
    "auto-launch": "^5.0.5",
    "axios": "^0.21.1",
    "cross-env": "^10.1.0",
    "date-fns": "^2.22.1",
    "electron-serve": "^1.1.0",
    "electron-store": "^8.0.0",
    "firebase": "^8.7.0",
    "framer-motion": "^4",
    "next": "^10.1.3",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-hook-form": "^7.10.1",
    "react-icons": "^4.2.0",
    "react-query": "^3.19.0",
    "react-to-print": "^2.12.6",
    "yup": "^0.32.9"
  },
  "devDependencies": {
    "@types/auto-launch": "^5.0.2",
    "@types/node": "^14.6.4",
    "@types/react": "^16.14.69",
    "@types/react-dom": "^16.9.8",
    "@typescript-eslint/eslint-plugin": "^4.26.0",
    "@typescript-eslint/parser": "^4.26.0",
    "electron": "^12.0.2",
    "electron-builder": "^22.10.5",
    "eslint": "^7.27.0",
    "eslint-config-next": "^11.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "nextron": "^6.0.6",
    "prettier": "^2.3.0",
    "typescript": "^4.2.3"
  },
  "build": {
    "appId": "br.com.toopdelivery.admin",
    "productName": "Toop Delivery",
    "copyright": "Copyright © 2021 Toop Delivery",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": {
      "from": ".",
      "filter": [
        "package.json",
        "app"
      ]
    },
    "publish": null,
    "extraFiles": [
      "libs"
    ]
  }
}
