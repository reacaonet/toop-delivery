# GojáDelivery - Variaveis de Ambiente

# ===========================================
# CONFIGURACOES DO SERVIDOR
# ===========================================
PORT=8100
NODE_ENV=development
PRODUCTION=false

# ===========================================
# URLS DOS SERVICOS
# ===========================================
PAYMENT_URL=http://localhost:8400
NOTIFICATION_URL=http://localhost:8200
DELIVERYMAN_URL=http://localhost:8300
INTEGRATION_URL=http://localhost:8300
PRODUCT_IMAGE_API=http://localhost:8500

# ===========================================
# DOCUMENTACAO DA API
# ===========================================
DOC_HOST=http://localhost:8100
DOC_TITLE="Gojá Delivery API"
DOC_DESCRIPTION="API Documentation for Gojá Delivery Platform"
DOC_VERSION="1.0.0"

# ===========================================
# JWT - AUTENTICACAO
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_SECRET_REFRESH=your-super-secret-refresh-key-change-in-production
JWT_TTL=24h
JWT_TTL_REFRESH=7d

# Chaves privadas RSA dos microservicos (deliveryman e payment) - antes estavam hardcoded no docker-compose.dev.yml
# Gerar com: openssl genrsa -out jwt_private.pem 2048
JWT_PRIVATE_KEY_DELIVERYMAN_MICRO=""
JWT_PRIVATE_KEY_PAYMENT_MICRO=""

# ===========================================
# BANCOS DE DADOS
# ===========================================

# MongoDB (Admin + Notification + Deliveryman)
MONGO_CONNECT_TYPE=mongodb
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=admin123
URL_MONGO=mongodb://admin:admin123@localhost:27017/ecbr?retryWrites=true&authSource=admin

# MongoDB vars for Notification service (DB_HOST/DB_PORT/DB_DATABASE)
DB_HOST=localhost
DB_PORT=27017
DB_DATABASE=ecbr

# PostgreSQL (Payment) - code uses PG_* vars
PG_USER=ecbr_payment
PG_PASSWORD=payment123
PG_DATABASE=payment
PG_HOST=localhost
PG_PORT=5432

# Redis (Cache/Filas)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ===========================================
# LTS VERSION
# ===========================================
LTS=v1

# ===========================================
# ARMAZENAMENTO - DIGITALOCEAN SPACES
# ===========================================
S3_SPACES_URL=https://nyc3.digitaloceanspaces.com
S3_SPACES_BUCKET_PRODUCTS=toopdelivery-products
S3_SPACES_BUCKET_PRODUCTS_FOLDER=images
S3_SPACES_KEY=your-digitalocean-key
S3_SPACES_SECRET=your-digitalocean-secret

# ===========================================
# PAGAMENTOS - CIELO
# ===========================================
PROVIDER_PAYMENT_CIELO=sandbox
PROVIDER_CIELO_FRAUDANALYSIS=false
MERCHANT_ID=your-cielo-merchant-id
MERCHANT_KEY=your-cielo-merchant-key
API_CIELO_E_COMMERCE=https://apisandbox.cieloecommerce.cielo.com.br
API_CIELO_E_COMERCE_QUERY=https://apiquerysandbox.cieloecommerce.cielo.com.br
CIELO_CARD_TOKEN=

# ===========================================
# PAGAMENTOS - BRASPAG
# ===========================================
BRASPAG_CLIENT_ID=your-braspag-client-id
BRASPAG_CLIENT_SECRET=your-braspag-client-secret
BRASPAG_OAUTH2_SERVER=https://authsandbox.braspag.com.br
BRASPAG_SPLIT=https://splitsandbox.braspag.com.br

# ===========================================
# PAGAMENTOS - IUGU
# ===========================================
IUGU_TOKEN_API=your-iugu-token
IUGU_ACCOUNT_ID=your-iugu-account-id

# ===========================================
# PAGAMENTOS - PAGARME
# ===========================================
PAGARME_API_KEY=your-pagarme-api-key
PAGARME_RECIPIENT_ID=your-pagarme-recipient-id

# ===========================================
# EMAIL - NODE MAILER
# ===========================================
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER=your-email@gmail.com
MAILER_PASSWORD=your-app-password
MAILER_NAME=GojáDelivery
MAILER_EMAIL=noreply@toopdelivery.com.br

# ===========================================
# FIREBASE - CONFIGURACAO WEB
# ===========================================
FIREBASE_apiKey=AIzaSyDiwhpuIwntQBFhYiQ1rgLSfDS5OPk9Hg8
FIREBASE_authDomain=enduring-honor-419212.firebaseapp.com
FIREBASE_databaseURL=https://enduring-honor-419212-default-rtdb.firebaseio.com/
FIREBASE_projectId=enduring-honor-419212
FIREBASE_storageBucket=enduring-honor-419212.firebasestorage.app
FIREBASE_messagingSenderId=52044825836
FIREBASE_appId=1:52044825836:web:b3cbec6d12da7588b8d1c9
FIREBASE_measurementId=G-XXXXXXXXXX

# ===========================================
# FIREBASE ADMIN SDK (para services)
# ===========================================
FIREBASE_SERVICE_ACCOUNT_PATH=/usr/src/app/firebase-adminsdk.json
CLOUD_FIREBASE_TYPE=service_account
CLOUD_FIREBASE_PROJECT_ID=your-project-id
CLOUD_FIREBASE_private_key_id=your-key-id
CLOUD_FIREBASE_private_key="-----BEGIN PRIVATE KEY-----\nYour-Private-Key\n-----END PRIVATE KEY-----\n"
CLOUD_FIREBASE_client_email=your-service-account@your-project.iam.gserviceaccount.com
CLOUD_FIREBASE_client_id=123456789
CLOUD_FIREBASE_auth_uri=https://accounts.google.com/o/oauth2/auth
CLOUD_FIREBASE_token_uri=https://oauth2.googleapis.com/token
CLOUD_FIREBASE_auth_provider_x509_cert_url=https://www.googleapis.com/oauth2/v1/certs
CLOUD_FIREBASE_client_x509_cert_url=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project.iam.gserviceaccount.com

# ===========================================
# TWILIO - SMS
# ===========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# GOOGLE MAPS & GEOLOCALIZACAO
# ===========================================
GOOGLE_MAPS=your-google-maps-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
CLOUD_MESSAGING_TOKEN=your-fcm-server-key

# ===========================================
# NOTIFICATION API
# ===========================================
NOTIFICATION_API_KEY=

# ===========================================
# CONFIGURACOES DE ENTREGA
# ===========================================

# Distancias maximas (em metros)
maxMetersDeliveryMan=10000
MAX_DIST_DRIVER=8000

# Tempo de espera (em segundos)
WAITING_TIME_DRIVER=30

# Preco maximo (em centavos)
PRICE_MAX=20000

# ===========================================
# GOOGLE CLOUD BIGQUERY
# ===========================================
BIGQUERY_PROJECT_ID=your-bigquery-project
BIGQUERY_KEY_FILE=./config/googlecloud.json

# ===========================================
# CONFIGURACOES DE DESENVOLVIMENTO
# ===========================================
DEBUG=toopdelivery:*
