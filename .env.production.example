# ===========================================
# ToopDelivery - Production Environment
# ===========================================
# Copy this file to .env and fill in the values
# cp .env.production.example .env
# docker compose -f docker-compose.production.yml up -d --build

# ─── Database Credentials ──────────────────────────────
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

POSTGRES_USER=ecbr_payment
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=payment

REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS_MINIMUM
JWT_SECRET_REFRESH=CHANGE_ME_RANDOM_64_CHARS_MINIMUM

# ─── Auth ──────────────────────────────────────────────
APP_KEY=CHANGE_ME_RANDOM_STRING

# ─── Service URLs (auto-resolved by Docker Compose) ────
# PAYMENT_URL=http://payment-microservice:8400
# NOTIFICATION_URL=http://notification-microservice:8200
# DELIVERYMAN_URL=http://deliveryman-microservice:8300

# ─── Firebase Admin SDK ────────────────────────────────
# Path to the service account JSON file on the HOST machine
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json
FIREBASE_serviceAccount=
FIREBASE_databaseURL=https://your-project-default-rtdb.firebaseio.com

# ─── External APIs ─────────────────────────────────────
GOOGLE_MAPS=your-google-maps-api-key
CIELO_CARD_TOKEN=
IUGU_TOKEN_API=
CLOUD_MESSAGING_TOKEN=

# ─── Notification ──────────────────────────────────────
NOTIFICATION_API_KEY=

# ─── Twilio ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── DigitalOcean Spaces ──────────────────────────────
S3_SPACES_URL=https://nyc3.digitaloceanspaces.com
S3_SPACES_BUCKET_PRODUCTS=toopdelivery-products
S3_SPACES_KEY=
S3_SPACES_SECRET=

# ─── Email ─────────────────────────────────────────────
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_USER=
MAILER_PASSWORD=
