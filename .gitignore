# ToopDelivery - Git Ignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development
.env.staging
.env.production

# Build outputs
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker
.dockerignore

# Database
*.sqlite
*.db

# Temporary files
tmp/
temp/

# Mobile specific
ios/build/
ios/Pods/
android/build/
android/app/build/
android/.gradle/

# Electron
out/
release/

# Backup files
*.bak
*.backup

# Certificates and keys
*.pem
*.key
*.crt
*.p12

# Configuration files with sensitive data
config/googlecloud.json
config/firebase-admin.json
